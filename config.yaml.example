# config.yaml.example
#
# This is a TEMPLATE. Copy this file to `config.yaml` before running the app:
#     cp config.yaml.example config.yaml
#
# Then either:
#   1. Delete the sample user below and use the app's "Sign Up" tab to create
#      your own account (recommended), or
#   2. Generate a real password hash and replace the placeholder below:
#
#      python3 -c "import streamlit_authenticator as stauth; print(stauth.Hasher().hash('yourpassword'))"
#
# Never commit your real config.yaml (with actual users/hashes) to GitHub —
# it's already excluded via .gitignore.

credentials:
  usernames:
    sampleuser:
      email: sample@example.com
      name: Sample User
      password: $2b$12$replace.this.with.a.real.bcrypt.hash.generated.above

cookie:
  name: rag_chatbot_auth
  key: replace_this_with_a_random_secret_key
  expiry_days: 7
